{
  "name": "horune",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @horune/web dev",
    "dev:desktop": "pnpm --filter @horune/desktop tauri dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "tauri": "pnpm --filter @horune/desktop tauri"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
