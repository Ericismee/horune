{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horune",
  "version": "0.1.0",
  "identifier": "app.horune.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Horune",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "Horune Floating Clock",
        "width": 430,
        "height": 205,
        "minWidth": 340,
        "minHeight": 175,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Time it your way",
    "longDescription": "A local-first floating clock and safe system action scheduler.",
    "copyright": "Copyright © 2026 Horune contributors",
    "category": "Productivity",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
